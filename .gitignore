# ---- never commit the game or anything made from it ----
# (decompressed modules, the loaded image, lifted C, test builds, romfs/exefs copies, dumps, keys)
work/
gen/
image/
exefs/
romfs/
*.bin
*.keys
*.nso
*.nca
*.nsp
*.xci
gamefile/
*.nup
*.nsz
*.xcz

# ---- build output and caches ----
build/
# (but launcher/Logic/Build/ is source: git on Windows ignores case, so build/ hid it and v0.5.2 was committed without it)
!launcher/Logic/Build/
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.sha1
*.log

# ---- Linux builds ----
build-linux/
*.so

# ---- NVIDIA's DLSS SDK (scripts/ngx_sdk.py): NVIDIA's files, never committed ----
ngx-sdk/

# ---- RenoDX's shaders compiled (scripts/renodx_shaders.py): worked from the game's own shaders, never committed ----
renodx_spv.h

# Triforce Setup's build output (setup\build.ps1, setup\pack_tools.ps1)
setup/out/
build1.done
# (Triforce) RenHDrum built by hand (scripts/renhdrum.py): the .dll is *.dll above
third_party/renhdrum/renhdrum.so

# ((Triforce VR) scripts/vr_text: made from the game on your PC (work/ is above)
scripts/vr_text/work_all/
scripts/vr_text/vr_edits.tsv
