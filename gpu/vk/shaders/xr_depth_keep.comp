#version 450
// VR's depth stereo (runtime/vk_xr.cpp vk_xr_keep_depth): the scene's depth, as it is once the scene is drawn, into an
// image of VR's own, which the game's later passes do not draw over, and each row's least and greatest stored depth
// (rows: h least then h greatest, as the bits of positive floats, which order as the floats do; cleared to +inf and 0
// before), from which the eyes' shader bounds its search along the row
// glslangValidator -V --target-env vulkan1.3 --vn XR_DEPTH_KEEP_COMP_SPV -o xr_depth_keep_comp_spv.h xr_depth_keep.comp
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth;
layout(binding = 1, r32f) uniform writeonly image2D kept;
layout(binding = 2, std430) buffer Rows { uint r[]; } rows;
layout(push_constant) uniform Push {
    ivec2 size;
    float nearer;   // +1: a greater stored depth is nearer, -1: a smaller one, 0: kept as it is
} p;

void main() {
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, p.size))) return;
    float d = texelFetch(depth, at, 0).r;
    // (Triforce VR) the nearest depth within two texels across and one up and down. The picture the eyes are made from is
    // upscaled and smoothed past the depth's size, so a near thing's edge pixels are part it and part what is behind it,
    // and the depth there was the background's: those pixels stayed behind while the thing moved by its depth, a faint copy
    // of its outline beside it in each eye (the hands, the nearest things, showed it most). With its depth grown over them
    // they go with it; a sliver of the background then goes with its edge instead, which reads as an edge, not a ghost
    if (p.nearer != 0.0)
        for (int y = -1; y <= 1; y++)
            for (int x = -2; x <= 2; x++) {
                const float n = texelFetch(depth, clamp(at + ivec2(x, y), ivec2(0), p.size - 1), 0).r;
                if ((n - d) * p.nearer > 0.0) d = n;
            }
    imageStore(kept, at, vec4(d));
    const uint bits = floatBitsToUint(max(d, 0.0));
    atomicMin(rows.r[at.y], bits);
    atomicMax(rows.r[p.size.y + at.y], bits);
}
